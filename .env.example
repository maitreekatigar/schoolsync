# LOCAL DEVELOPMENT ONLY. Never upload your real .env file.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/schoolsync
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/schoolsync
# Generate a unique random secret for your machine. Example command in README.
SESSION_SECRET=replace-with-a-unique-random-value-at-least-32-characters
SESSION_HTTPS_ONLY=false
ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
DEBUG=true
ITEMS_PER_PAGE=10
# Legacy Clerk API authentication settings (optional if not using Clerk API tokens)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=

# Optional SMTP settings for Forgot password (required to send real emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
APP_BASE_URL=http://127.0.0.1:8000
